# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Set callback URL to http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Provider API keys (server-side only, injected per session)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenAI-compatible gateway base URL
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: restrict login to specific GitHub usernames (comma-separated)
ALLOWED_GITHUB_LOGINS=

# Where /auth/callback sends the browser after a successful login.
# Default "/" (same-origin UI behind a proxy).
# UI_ORIGIN=http://localhost:5173

# Cross-origin allow-list for the API, comma-separated. Empty (the default)
# adds no CORS middleware at all, which is correct when the UI is same-origin.
# Never "*": these endpoints are credentialed.
# CORS_ORIGINS=http://localhost:5173

# Where session workspaces (one repo clone per session) live. Removed on close.
# WORKSPACES_DIR=./workspaces

# Transcript budget. Past this many characters the oldest tool observations are
# collapsed to "[truncated N chars]"; user messages and agent replies are never
# touched. Default: 240000
# MAX_CONTEXT_CHARS=240000

# Max agent turns running at the same time (default: 3). A message that would
# exceed it is rejected with 429.
# MAX_CONCURRENT_SESSIONS=3

# Per-turn wall-clock budget in seconds (default: 900). A turn that reaches it
# at a step boundary ends with finish_reason `time_limit`; a command still
# running when the deadline passes is killed first, the way /stop kills it.
# Cost is always $0 under MSWEA_COST_TRACKING=ignore_errors, so without this
# steps are the only budget a turn has — and a step is not a unit of time.
# A session may override it with `wall_seconds` (60..3600) at creation.
# TURN_WALL_SECONDS=900

# Idle-session TTL. A session that has been `idle` (never `running`) for longer
# than this is closed exactly like /close — sandbox killed, workspace deleted,
# status `closed`, closed_reason `expired`. Without it a repo clone per session
# lives until someone remembers to press close. 0 disables the reaper.
# Default: 21600 (6 h).
# SESSION_IDLE_TTL_SECONDS=21600

# How often the reaper looks for expired sessions, in seconds (default: 300).
# SESSION_REAP_INTERVAL_SECONDS=300

# SSE comment heartbeat interval in seconds (default: 15)
# SSE_HEARTBEAT_SECONDS=15

# Optional: SQLite database path (default: cloud_harness.db)
# DB_PATH=cloud_harness.db

# --- GroundTruth -----------------------------------------------------------
# Leave GT_PRODUCER_ARTIFACT UNSET here. It pins gt-index to one exact
# certified benchmark artifact; the cloud image deliberately ships a
# source-built, patched producer (see cloud/producer/README.md) so it can index
# arbitrary user repositories. Setting it would make _binary_certification()
# fail closed and every session would degrade to gt_unavailable.
# GT_PRODUCER_ARTIFACT=
#
# Likewise leave GT_TASK_ID / GT_PRODUCT_SOURCE_SHA unset. Setting only one
# puts gt_engine in "benchmark_invalid" scope and indexing refuses with
# GT_INDEX_IDENTITY_INVALID; setting both makes a failed index raise
# BenchmarkGraphRequired instead of degrading. Cloud sessions want
# "local_unbound" (correct-or-quiet).

# --- Sandboxing / egress policy --------------------------------------------
# SANDBOX_MODE=local (default) runs agent commands in the server process's own
# machine account, as before. SANDBOX_MODE=docker gives every session its own
# container (gt-sandbox-<session_id>) with the workspace bind-mounted at
# /workspace, uid 1000, 2 GB / 2 CPUs / 512 pids, a tmpfs /tmp, and NO docker
# socket. It fails closed: a sandbox that will not start fails the session, it
# never silently falls back to local execution.
# SANDBOX_MODE=local
#
# The image the session containers run (build: docker build -t gt-sandbox:latest
# cloud/sandbox, or `docker compose --profile build build`).
# SANDBOX_IMAGE=gt-sandbox:latest
#
# The internal (no route off-host, no external DNS) network sandboxes join, and
# the allow-listed proxy that is their only way out.
# SANDBOX_NETWORK=gt-sandbox-net
# SANDBOX_PROXY_CONTAINER=gt-egress-proxy
# SANDBOX_PROXY_IMAGE=gt-egress-proxy:latest
# SANDBOX_PROXY_URL=http://gt-egress-proxy:3128
#
# Egress allow-list. Always reachable (git):
#   github.com, *.github.com, codeload.github.com, objects.githubusercontent.com
# Reachable while SANDBOX_ALLOW_REGISTRIES is truthy (default 1, because agents
# run tests that install packages):
#   pypi.org, files.pythonhosted.org, registry.npmjs.org
# Everything else is refused by the proxy with 403 — the model API included.
# Model calls happen in the SERVER process; a sandbox never needs them.
# SANDBOX_ALLOW_REGISTRIES=1
#
# Extra hosts, comma-separated. `*.example.com` wildcards are supported.
# SANDBOX_EGRESS_ALLOW=
#
# Resource caps on each sandbox container.
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=512
# SANDBOX_TMPFS_SIZE=512m
#
# Extra environment variable NAMES (comma-separated) forwarded from the server
# into sandbox commands. Only PATH/HOME/LANG/TERM, the proxy variables and the
# names listed here can cross the boundary at all, and anything that looks like
# a credential (*_API_KEY, *_TOKEN, *_SECRET, ...) is dropped even if listed.
# SANDBOX_ENV_PASSTHROUGH=
#
# Compose only: the HOST directory holding session workspaces. It is mounted
# into the server container at the SAME absolute path and used as
# WORKSPACES_DIR, because the daemon resolves a sandbox's bind mount on the
# host, not inside the server container.
# WORKSPACES_HOST_DIR=/srv/gt-workspaces
